# À copier dans .streamlit/secrets.toml (local) ou dans les secrets de l'app (Streamlit Cloud).
# Ne jamais mettre ce fichier avec de vraies valeurs dans un zip ou sur GitHub.

DATABASE_URL = "postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"
APP_URL = "https://ton-app.streamlit.app"

# GeniusPay : Dashboard > Paramètres > API (commence par les clés sandbox)
GENIUSPAY_API_KEY = "pk_sandbox_xxxxxxxx"
GENIUSPAY_API_SECRET = "sk_sandbox_xxxxxxxx"

# Email de réinitialisation du mot de passe (inchangé)
# SMTP_HOST = "smtp.gmail.com"
# SMTP_USER = "..."
# SMTP_PASSWORD = "..."
